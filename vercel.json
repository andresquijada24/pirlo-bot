{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/club/(.*)",
      "destination": "/api"
    },
    {
      "source": "/clubes",
      "destination": "/api"
    },
    {
      "source": "/widget/(.*)",
      "destination": "/api"
    },
    {
      "source": "/panel",
      "destination": "/api"
    },
    {
      "source": "/entrar",
      "destination": "/api"
    },
    {
      "source": "/mi-cuenta",
      "destination": "/api"
    },
    {
      "source": "/panel/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{tesseract.js,tesseract.js-core}/**"
    }
  }
}

# PIRLO BOT — variables de entorno
# Copia este archivo a .env.local y rellena los valores. .env.local está ignorado por git.
# Nunca pegues valores reales en chats, issues, logs ni commits.

APP_ENV=development            # development | production
LOG_LEVEL=info                 # debug | info | warn | error

# --- Discord ---
DISCORD_APPLICATION_ID=1562889315657195530
DISCORD_PUBLIC_KEY=            # Developer Portal → General Information → Public Key
DISCORD_BOT_TOKEN=             # SECRETO. Developer Portal → Bot → Token
DISCORD_DEV_GUILD_ID=          # Tu servidor de PRUEBAS (no el servidor de referencia)

# --- Supabase (proyecto PIRLO-BOT, independiente de Marítimo) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # SECRETO. Solo servidor. Nunca en frontend ni en Discord.
# SUPABASE_ANON_KEY=           # No se usa en la v1 (reservada para el futuro panel web)

# Solo para migraciones / CLI / CI. No se usa en runtime.
DATABASE_URL=

# --- Proveedores de estadísticas ---
MARITIMO_API_BASE_URL=
MARITIMO_API_KEY=              # SECRETO. Clave de SOLO LECTURA emitida por maritimo.app
MARITIMO_CLUB_ID=              # uuid del club de PIRLO BOT que recibe los datos de Marítimo
OURPROCLUB_API_KEY=            # Solo si existe acceso autorizado

# --- Tareas programadas ---
CRON_SECRET=                   # SECRETO. Protege /api/cron/sync
EA_BRIDGE_TOKEN=               # SECRETO (32+). Clave del puente que envía partidos de EA

# Panel interno (/panel): Client Secret de OAuth2 de Discord. Solo en el servidor (Vercel, Sensitive).
DISCORD_CLIENT_SECRET=
# Dueños de PIRLO BOT (IDs de Discord, separados por comas). Vacío = dueño por defecto.
PIRLO_OWNER_DISCORD_IDS=
